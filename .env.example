# AegisMCP Environment Configuration
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-minimum
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# SQLite (default, for development)
DATABASE_URL=sqlite+aiosqlite:///./aegis.db

# PostgreSQL (for production) - uncomment and configure
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aegis

# API Key Authentication
# Generate with: python -c "import secrets; print('aegis_live_' + secrets.token_hex(32))"
# Or use the 'API Keys & SDK' tab in the AegisMCP dashboard
API_KEY_HASH=

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend (for SDK examples)
AEGIS_API_KEY=
AEGIS_BASE_URL=http://localhost:8000
# Tenancy & session bootstrap
DEFAULT_ORG_ID=org-1
ALLOWED_ORG_IDS=org-1
ALLOW_SESSION_BOOTSTRAP=true
# Shared secret required by /api/v1/auth/session when set (empty = disabled)
AEGIS_BOOTSTRAP_TOKEN=
# Separation of duties: keep false except for single-operator demos
ALLOW_SELF_APPROVAL=false

# Optional Redis: multi-worker SSE fan-out + distributed rate limiting
REDIS_URL=

# MCP JSON-RPC gateway / OTLP receiver
MCP_UPSTREAM_TIMEOUT_SECONDS=10
OTLP_MAX_SPANS=5000

# ---------------------------------------------------------------------------
# PRODUCTION (Vercel frontend + Render backend + Supabase Postgres)
# ---------------------------------------------------------------------------
# Every value below is validated at startup when ENVIRONMENT=production:
# a placeholder or short SECRET_KEY, or a non-https/loopback ALLOWED_ORIGINS
# entry, aborts the process with a validation error instead of booting weakly.
#
# ENVIRONMENT=production
# SECRET_KEY=<python -c "import secrets;print(secrets.token_urlsafe(48))">
# ALLOWED_ORIGINS=https://your-app.vercel.app
#
# Supabase pooler connection string (Project Settings -> Database -> Connection
# pooler, port 6543, Transaction mode). asyncpg needs the query params below.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
#
# Seeding is disabled automatically outside development: production tables are
# created empty and only ever hold real ingested traffic.
#
# Session bootstrap mints an operator identity without an IdP. Keep it off in
# production and authenticate with API keys, or front it with an SSO proxy and
# set a shared secret:
# ALLOW_SESSION_BOOTSTRAP=false
# AEGIS_BOOTSTRAP_TOKEN=<shared secret held by the SSO proxy>
#
# Optional: Redis gives multi-worker SSE fan-out + distributed rate limits.
# REDIS_URL=rediss://default:<password>@<host>:6379
